                <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n    class Cliente {\n        +int id\n        +string nome\n        +string tipo\n        +string telefone\n        +string documento\n    }\n\n    class Veiculo {\n        +int id\n        +int cliente_id\n        +string placa\n        +string modelo\n        +string marca\n    }\n\n    class Lavador {\n        +int id\n        +string nome\n        +string telefone\n        +boolean ativo\n    }\n\n    class Servico {\n        +int id\n        +string descricao\n        +decimal valor\n    }\n\n    class OrdemServico {\n        +int id\n        +int veiculo_id\n        +int servico_id\n        +int lavador_id\n        +int usuario_id\n        +string status\n        +datetime data_hora\n    }\n\n    class Pagamento {\n        +int id\n        +int ordem_servico_id\n        +string forma_pagamento\n        +decimal valor_pago\n        +datetime data_pagamento\n    }\n\n    Cliente \&quot;1\&quot; --&gt; \&quot;*\&quot; Veiculo : possui\n    Veiculo \&quot;1\&quot; --&gt; \&quot;*\&quot; OrdemServico : participa\n    Servico \&quot;1\&quot; --&gt; \&quot;*\&quot; OrdemServico : define\n    Lavador \&quot;1\&quot; --&gt; \&quot;*\&quot; OrdemServico : executa\n    OrdemServico \&quot;1\&quot; --&gt; \&quot;1\&quot; Pagamento : gera\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="LvO8Qasc-3p-qwH2PtHa-79">
