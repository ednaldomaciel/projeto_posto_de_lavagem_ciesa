# ============================================================
# ARQUIVO DE EXEMPLO DE VARIÁVEIS DE AMBIENTE (.env)
# Projeto: Sistema de Gestão do Lava Jato do Valmir
# ============================================================

# 1. Chave Secreta da Aplicação (Gere uma chave única para produção)
SECRET_KEY=gere-uma-chave-secreta-longa-e-aleatoria

# 2. Modo de Depuração (Mantenha True em DEV; defina como False em PRODUÇÃO!)
DEBUG=True

# 3. Hosts Permitidos (Separados por vírgula; obrigatório se DEBUG=False)
ALLOWED_HOSTS=localhost,127.0.0.1,meu-lava-jato.onrender.com

# 4. Origens Confiáveis para CSRF (Obrigatório para requisições HTTPS em produção)
CSRF_TRUSTED_ORIGINS=http://localhost,http://127.0.0.1,https://meu-lava-jato.onrender.com

# 5. Conexão com Banco de Dados:
# Para Desenvolvimento (SQLite local):
DATABASE_URL=sqlite:///db.sqlite3

# Para Produção (PostgreSQL em nuvem):
# DATABASE_URL=postgresql://usuario:senha@host:5432/nome_banco?sslmode=require

# 6. Configuração exclusiva do Docker Compose:
POSTGRES_DB=lavajato_db
POSTGRES_USER=lavajato_user
POSTGRES_PASSWORD=defina-uma-senha-forte
